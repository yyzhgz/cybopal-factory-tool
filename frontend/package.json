{
  "name": "cybopal-factory-tool-frontend",
  "version": "0.1.0",
  "description": "Factory-facing desktop application for CyboPal calibration and maintenance.",
  "author": "CyboPal",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:desktop": "concurrently -k \"npm run dev\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "pack": "npm run build && electron-builder --dir --config electron-builder.config.cjs",
    "dist:mac": "npm run build && electron-builder --mac dmg --config electron-builder.config.cjs",
    "dist:mac:full": "bash ../scripts/build-macos-app.sh"
  },
  "dependencies": {
    "@lucide/vue": "^1.24.0",
    "@vueuse/core": "^12.0.0",
    "naive-ui": "^2.40.0",
    "pinia": "^2.3.0",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@electron/notarize": "^2.5.0",
    "@vitejs/plugin-vue": "^5.2.0",
    "concurrently": "^9.1.0",
    "electron": "33.4.11",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vue-tsc": "^2.2.0",
    "wait-on": "^8.0.1"
  }
}
